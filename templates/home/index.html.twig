{% extends 'base.html.twig' %}

{% block title %}Film en Serie Tracker{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/titles.js') }}" defer></script>
{% endblock %}


{% block body %}
    <style>
        .example-wrapper {
            margin: 1em auto;
            max-width: 800px;
            width: 95%;
            font: 18px/1.5 sans-serif;
        }

        .example-wrapper code {
            background: #F5F5F5;
            padding: 2px 6px;
        }
    </style>
    <div class="example-wrapper">
        <form id="title-form" data-api-url="{{ path('api_title_index') }}">
            <input name="name" placeholder="Naam" required>
            <select name="type" required>
                <option value="film">Film</option>
                <option value="serie">Serie</option>
            </select>
            <input name="year" type="number" placeholder="Jaartal" required>
            <label><input name="watched" type="checkbox"> Gezien</label>
            <button type="submit">Toevoegen</button>
        </form>
        <p id="error"></p>

        <ul id="title-list"></ul>
    </div>

{% endblock %}
