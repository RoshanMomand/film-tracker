{% extends 'base.html.twig' %}

{% block title %}Film en Serie Tracker{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/titles.js') }}" defer></script>
{% endblock %}


{% block body %}
    <style>
        .example-wrapper {
            /*margin: 1em auto;*/
            max-width: 800px;
            font: 18px/1.5 sans-serif;
            margin: 0 auto;
        }

        .example-wrapper code {
            background: #F5F5F5;
            padding: 2px 6px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 1em;
        }

        th, td {
            text-align: left;
            padding: 6px 8px;
            border-bottom: 1px solid #ddd;
        }
    </style>

    <div class="example-wrapper">
        <form id="title-form"
              data-api-url="{{ path('api_title_index') }}"
              data-edit-url="{{ path('app_title_edit', {id: 'ID'}) }}"
              data-method="POST">
            <input name="name" placeholder="Naam" required>
            <select name="type" required>
                <option value="film">Film</option>
                <option value="serie">Serie</option>
            </select>
            <input name="year" type="number" placeholder="Jaartal" required>
            <label><input name="watched" type="checkbox"> Gezien</label>
            <button type="submit">Toevoegen</button>
        </form>
        <p id="error"></p>

        {# Filter function with select #}
        <select id="filter-type">
            <option value="">Alle types</option>
            <option value="film">Films</option>
            <option value="serie">Series</option>
            <option value="watched">Gezien</option>
        </select>

        {# Search function based on the Title #}
        <input id="search-title" type="text" placeholder="Zoek naar titel...">

        <table>
            <thead>
            <tr>
                <th>Naam</th>
                <th>Type</th>
                <th>Jaartal</th>
                <th>Gezien</th>
                <th></th>
            </tr>
            </thead>
            <tbody id="title-list"></tbody>
        </table>
    </div>

{% endblock %}
